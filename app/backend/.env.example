# Required for AI coaching
GEMINI_API_KEY=your-gemini-api-key

# Model paths
MODEL_CHECKPOINT_PATH=./checkpoints/pose_transformer_best.pt
SIGNS_JSON_PATH=./data/signs.json
WLASL_JSON_PATH=../../wlasl/videos/WLASL_v0.3.json
VIDEOS_DIR=../../wlasl/videos

# Server
HOST=0.0.0.0
PORT=8000
# For EC2: set to http://<your-ec2-public-ip> or your domain
CORS_ORIGINS=http://localhost:4200

# Gemini Live
GEMINI_MODEL=gemini-2.0-flash-live
GEMINI_COACHING_ENABLED=true

# Model config
CONFIDENCE_THRESHOLD=0.25
MAX_SEQ_LEN=150
NUM_CLASSES=2000
FEATURE_DIM=225

# Database
DATABASE_URL=postgresql+psycopg2://mouna:mouna@localhost:5432/mouna

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Scoring
MIN_ATTEMPTS_FOR_COMPLETION=5
COMPLETION_ACCURACY_THRESHOLD=0.70
